@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/">WeDoAnyJobs</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#mainNav" aria-controls="mainNav"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <!-- LEFT LINKS -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        🏠 Home
                    </NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="joblistings">
                                💼 Job Listings
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="applications">
                                📄 Applications
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="employers">
                                🏢 Employers
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="jobseekers">
                            👥 Job Seekers
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="feedbacks">
                            🛠 Feedback
                        </NavLink>
                    </li>
                </AuthorizeView>

                <AuthorizeView Roles="JobSeeker, Employer">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="feedbacks/create">
                            ✍️ Create Feedback
                        </NavLink>
                    </li>
                </AuthorizeView>
            </ul>

            <ul class="navbar-nav ms-auto align-items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Manage">
                                👤 @context.User.Identity?.Name
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <form action="Account/Logout" method="post" class="m-0">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </Authorized>

                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Login">
                                Login
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="btn btn-primary btn-sm" href="Account/Register">
                                Register
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
