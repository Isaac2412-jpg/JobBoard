@page "/jobseekers/edit/{id:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using JobBoard.Components.Domain
@using JobBoard.Data
@inject IDbContextFactory<JobBoardContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "JobSeeker, Admin")]

<PageTitle>Edit JobSeeker</PageTitle>

<h1>Edit</h1>
<h2>JobSeeker</h2>
<hr />

@if (JobSeeker == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="JobSeeker" OnValidSubmit="UpdateJobSeeker" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="mb-3">
                    <label class="form-label">Name:</label>
                    <InputText @bind-Value="JobSeeker.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email:</label>
                    <InputText @bind-Value="JobSeeker.Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Education Level:</label>
                    <InputText @bind-Value="JobSeeker.EducationLevel" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">LinkedIn:</label>
                    <InputText @bind-Value="JobSeeker.LinkedInPath" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Experience:</label>
                    <InputTextArea @bind-Value="JobSeeker.Experience" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div class="mt-3">
    <a href="/jobseekers">Back to List</a>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private JobBoardContext? _context;
    private JobSeeker? JobSeeker;

    protected override async Task OnInitializedAsync()
    {
        _context = DbFactory.CreateDbContext();
        JobSeeker = await _context.JobSeeker.FirstOrDefaultAsync(j => j.Id == Id);
    }

    private async Task UpdateJobSeeker()
    {
        if (_context == null || JobSeeker == null) return;

        _context.JobSeeker.Update(JobSeeker);
        await _context.SaveChangesAsync();

        NavigationManager.NavigateTo("/jobseekers");

        if (string.IsNullOrWhiteSpace(JobSeeker.EducationLevel))
            JobSeeker.EducationLevel = "N/A";

    }

    public async ValueTask DisposeAsync()
    {
        if (_context != null)
            await _context.DisposeAsync();
    }
}
