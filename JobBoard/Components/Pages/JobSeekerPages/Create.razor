@page "/jobseekers/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using JobBoard.Components.Domain
@using JobBoard.Data
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<JobBoardContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "JobSeeker, Admin")]

<PageTitle>Create JobSeeker Profile</PageTitle>

<h1>Create</h1>
<h2>JobSeeker</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <EditForm Model="JobSeeker" OnValidSubmit="AddJobSeeker" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label class="form-label">Name:</label>
                <InputText @bind-Value="JobSeeker.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email:</label>
                <InputText @bind-Value="JobSeeker.Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Education Level:</label>
                <InputText @bind-Value="JobSeeker.EducationLevel" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">LinkedIn:</label>
                <InputText @bind-Value="JobSeeker.LinkedInPath" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Experience:</label>
                <InputTextArea @bind-Value="JobSeeker.Experience" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div class="mt-3">
    <a href="/jobseekers">Back to List</a>
</div>

@code {
    private JobSeeker JobSeeker { get; set; } = new();

    private async Task AddJobSeeker()
    {
        using var context = DbFactory.CreateDbContext();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        // One profile per account
        var existing = await context.JobSeeker.FirstOrDefaultAsync(j => j.IdentityUserId == userId);
        if (existing != null)
        {
            NavigationManager.NavigateTo($"/jobseekers/edit/{existing.Id}");
            return;
        }

        if (string.IsNullOrWhiteSpace(JobSeeker.EducationLevel))
            JobSeeker.EducationLevel = "N/A";


        JobSeeker.IdentityUserId = userId;

        context.JobSeeker.Add(JobSeeker);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/jobseekers");
    }
}
