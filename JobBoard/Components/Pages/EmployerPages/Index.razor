@page "/employers"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using JobBoard.Components.Domain
@using JobBoard.Data
@implements IAsyncDisposable
@inject IDbContextFactory<JobBoardContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Employers</PageTitle>

<h1>Employers</h1>

@if (Employers == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <QuickGrid TItem="Employer" Class="table" Items="@(Employers as IQueryable<Employer>)">
        <PropertyColumn Property="e => e.CompanyName" Title="Company Name" />
        <PropertyColumn Property="e => e.CompanyEmail" Title="Company Email" />
        <PropertyColumn Property="e => e.CompanyLogoPath" Title="Logo" />
        <PropertyColumn Property="e => e.Industry" Title="Industry" />
        <PropertyColumn Property="e => e.Location" Title="Location" />
        <PropertyColumn Property="e => e.WebsiteUrl" Title="Website" />

        @* Admin-only column *@
        @if (IsAdmin)
        {
            <PropertyColumn Property="e => e.IdentityUserId" Title="User ID" />
        }

        <TemplateColumn Context="e" Title="Actions">
            <a href="@($"/employers/details/{e.Id}")">Details</a>

            @if (IsAdmin || IsOwner(e))
            {
                <text> | <a href="@($"/employers/edit/{e.Id}")">Edit</a></text>
                <text> | <a href="@($"/employers/delete/{e.Id}")">Delete</a></text>
            }
        </TemplateColumn>
    </QuickGrid>

    @* Employer "Create" button only if logged-in user is an Employer *@
    @if (IsEmployer)
    {
        <p class="mt-3">
            <a href="/employers/create" class="btn btn-primary">Create New</a>
        </p>
    }
}

@code {
    private JobBoardContext? context;
    private IQueryable<Employer>? Employers;
    private string? currentUserId;
    private bool IsAdmin { get; set; } = false;
    private bool IsEmployer { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        Employers = context.Employer; // IQueryable

        // Get logged-in user info
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            IsAdmin = user.IsInRole("Admin");
            IsEmployer = user.IsInRole("Employer");
        }
    }

    // Helper: checks if the current user owns this employer record
    private bool IsOwner(Employer employer)
    {
        if (currentUserId == null) return false;
        return employer.IdentityUserId == currentUserId;
    }

    public async ValueTask DisposeAsync()
    {
        if (context != null)
        {
            await context.DisposeAsync();
        }
    }
}

