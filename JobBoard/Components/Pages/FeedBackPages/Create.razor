@page "/feedbacks/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using JobBoard.Components.Domain
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<JobBoard.Data.JobBoardContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Feedback</PageTitle>

<h1>Create Feedback</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <EditForm Model="@FeedBack" OnValidSubmit="AddFeedBack">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="mb-3">
                <label class="form-label">Message</label>
                <InputTextArea class="form-control" @bind-Value="FeedBack.Message" />
                <ValidationMessage For="() => FeedBack.Message" class="text-danger" />
            </div>

            <p class="text-muted">
                Date will be set automatically when you submit.
            </p>

            <button type="submit" class="btn btn-primary">Submit Feedback</button>
            <a class="btn btn-secondary ms-2" href="/feedbacks">Back</a>
        </EditForm>
    </div>
</div>

@code {
    private FeedBack FeedBack { get; set; } = new();

    private async Task AddFeedBack()
    {
        using var context = DbFactory.CreateDbContext();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        FeedBack.DateSubmitted = DateTime.Now;
        FeedBack.IdentityUserId = userId!;

        context.FeedBack.Add(FeedBack);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/feedbacks");
    }
}
