@page "/joblistings/details/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using JobBoard.Components.Domain
@inject IDbContextFactory<JobBoard.Data.JobBoardContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Job Listing Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>JobListing</h2>
    <hr />
    @if (joblisting is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Job Title</dt>
            <dd class="col-sm-10">@joblisting.Title</dd>

            <dt class="col-sm-2">JobType</dt>
            <dd class="col-sm-10">@joblisting.JobType</dd>

            <dt class="col-sm-2">Industry</dt>
            <dd class="col-sm-10">@joblisting.Industry</dd>

            <dt class="col-sm-2">Salary</dt>
            <dd class="col-sm-10">@joblisting.Salary</dd>

            <dt class="col-sm-2">Location</dt>
            <dd class="col-sm-10">@joblisting.Location</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@joblisting.Description</dd>

            <dt class="col-sm-2">Requirements</dt>
            <dd class="col-sm-10">@joblisting.Requirements</dd>

            <dt class="col-sm-2">DatePosted</dt>
            <dd class="col-sm-10">@joblisting.DatePosted</dd>

            <dt class="col-sm-2">Company</dt>
            <dd class="col-sm-10">
                <NavLink href="@($"/employers/details/{joblisting.EmployerId}")">
                    @(joblisting.Employer?.CompanyName ?? "Unknown Company")
                </NavLink>
            </dd>
        </dl>

        <div>
            <a href="@($"/joblistings/edit/{joblisting.Id}")">Edit</a> |
            <a href="/joblistings">Back to List</a>
        </div>
    }
</div>

@code {
    private JobListing? joblisting;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        joblisting = await context.JobListing
            .Include(j => j.Employer)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (joblisting is null)
        {
            NavigationManager.NavigateTo("/notfound");
        }
    }
}
