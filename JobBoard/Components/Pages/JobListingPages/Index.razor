@page "/joblistings"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using JobBoard.Components.Domain
@using JobBoard.Data

@inject IDbContextFactory<JobBoardContext> DbFactory

<PageTitle>Job Listings</PageTitle>

<h1 class="mb-3">Job Listings</h1>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="flex-grow-1" style="min-width: 260px;">
        <input class="form-control"
               placeholder="Search (Title, JobType, Industry, Location, etc.)"
               @bind="SearchText"
               @bind:event="oninput" />
    </div>

    <AuthorizeView Roles="Admin, Employer">
        <a href="/joblistings/create" class="btn btn-primary">Create New</a>
    </AuthorizeView>
</div>

@if (AllJobListings == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="muted mb-2">
        Showing <strong>@FilteredJobListings.Count()</strong> job(s)
    </div>

    <div class="row g-3">
        @foreach (var j in FilteredJobListings)
        {
            <div class="col-12">
                <div class="card card-hover">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="w-100">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h5 class="mb-0">@j.Title</h5>

                                    @if (!string.IsNullOrWhiteSpace(j.JobType))
                                    {
                                        <span class="badge rounded-pill badge-soft">@j.JobType</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(j.Industry))
                                    {
                                        <span class="badge text-bg-light">@j.Industry</span>
                                    }
                                </div>

                                <div class="muted mt-1">
                                    @if (!string.IsNullOrWhiteSpace(j.Location))
                                    {
                                        <span class="me-3">📍 @j.Location</span>
                                    }
                                    <span class="me-3">💰 @j.Salary</span>
                                    <span>🗓️ @j.DatePosted</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(j.Description))
                                {
                                    <div class="mt-2 muted">
                                        @((j.Description.Length > 170) ? j.Description.Substring(0, 170) + "..." : j.Description)
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(j.Requirements))
                                {
                                    <div class="mt-2">
                                        <div class="fw-semibold">Requirements</div>
                                        <div class="muted">
                                            @((j.Requirements.Length > 170) ? j.Requirements.Substring(0, 170) + "..." : j.Requirements)
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="text-end" style="min-width: 190px;">
                                <!-- Everyone sees Details -->
                                <a class="btn btn-primary w-100 mb-2"
                                   href="@($"/joblistings/details/{j.Id}")">
                                    Details
                                </a>

                                <!-- Only Admin/Employer sees Edit/Delete -->
                                <AuthorizeView Roles="Admin, Employer">
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-outline-secondary w-100"
                                           href="@($"/joblistings/edit/{j.Id}")">
                                            Edit
                                        </a>
                                        <a class="btn btn-outline-danger w-100"
                                           href="@($"/joblistings/delete/{j.Id}")">
                                            Delete
                                        </a>
                                    </div>

                                    <div class="muted small mt-2">
                                        Employer ID: @j.EmployerId
                                    </div>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<JobListing>? AllJobListings;
    private string SearchText = "";

    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();

        AllJobListings = await context.JobListing
            .AsNoTracking()
            .Include(j => j.Employer)
            .ToListAsync();
    }

    private IEnumerable<JobListing> FilteredJobListings
    {
        get
        {
            if (AllJobListings == null) return Enumerable.Empty<JobListing>();
            if (string.IsNullOrWhiteSpace(SearchText)) return AllJobListings;

            var tokens = SearchText
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            // AND logic: every word must match at least 1 field
            return AllJobListings.Where(j => tokens.All(t =>
                ContainsCI(j.Title, t) ||
                ContainsCI(j.JobType, t) ||
                ContainsCI(j.Industry, t) ||
                ContainsCI(j.Location, t) ||
                ContainsCI(j.Description, t) ||
                ContainsCI(j.Requirements, t) ||
                j.Salary.ToString().Contains(t) ||
                j.EmployerId.ToString().Contains(t)
            ));
        }
    }

    private static bool ContainsCI(string? text, string token)
        => !string.IsNullOrWhiteSpace(text)
           && text.Contains(token, StringComparison.OrdinalIgnoreCase);
}
