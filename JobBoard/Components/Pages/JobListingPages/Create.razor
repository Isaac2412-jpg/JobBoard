@page "/joblistings/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using JobBoard.Components.Domain
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<JobBoard.Data.JobBoardContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin, Employer")]

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>JobListing</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="JobListing" OnValidSubmit="AddJobListing" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="title" class="form-label">Title:</label> 
                <InputText id="title" @bind-Value="JobListing.Title" class="form-control" /> 
                <ValidationMessage For="() => JobListing.Title" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="jobtype" class="form-label">JobType:</label> 
                <InputText id="jobtype" @bind-Value="JobListing.JobType" class="form-control" /> 
                <ValidationMessage For="() => JobListing.JobType" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="industry" class="form-label">Industry:</label> 
                <InputText id="industry" @bind-Value="JobListing.Industry" class="form-control" /> 
                <ValidationMessage For="() => JobListing.Industry" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="salary" class="form-label">Salary:</label> 
                <InputNumber id="salary" @bind-Value="JobListing.Salary" class="form-control" /> 
                <ValidationMessage For="() => JobListing.Salary" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="location" class="form-label">Location:</label> 
                <InputText id="location" @bind-Value="JobListing.Location" class="form-control" /> 
                <ValidationMessage For="() => JobListing.Location" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="description" class="form-label">Description:</label> 
                <InputText id="description" @bind-Value="JobListing.Description" class="form-control" /> 
                <ValidationMessage For="() => JobListing.Description" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="requirements" class="form-label">Requirements:</label> 
                <InputText id="requirements" @bind-Value="JobListing.Requirements" class="form-control" /> 
                <ValidationMessage For="() => JobListing.Requirements" class="text-danger" /> 
            </div>         
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/joblistings">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private JobListing JobListing { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddJobListing()
    {
        using var context = DbFactory.CreateDbContext();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        // Find employer profile linked to logged-in employer account
        var employer = await context.Employer
            .FirstOrDefaultAsync(e => e.IdentityUserId == userId);

        if (employer == null)
        {
            // Employer must create profile first
            NavigationManager.NavigateTo("/employers/create");
            return;
        }

        JobListing.DatePosted = DateTime.Now;
        JobListing.EmployerId = employer.Id;

        context.JobListing.Add(JobListing);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/joblistings");
    }
}
