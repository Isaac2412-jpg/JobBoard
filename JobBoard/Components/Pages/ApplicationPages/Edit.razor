@page "/applications/edit/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using JobBoard.Components.Domain
@using JobBoard.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Employer,Admin")]

@inject IDbContextFactory<JobBoardContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Edit Application</PageTitle>

<h1>Edit</h1>
<h2>Application</h2>
<hr />

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (Application == null)
{
    <div class="alert alert-danger">Application not found.</div>
}
else
{
    <EditForm Model="Application" OnValidSubmit="UpdateApplication">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Job Listing ID</label>
            <InputNumber class="form-control" @bind-Value="Application.JobListingId" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Job Seeker (Identity GUID)</label>
            <InputText class="form-control" @bind-Value="Application.JobSeekerId" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Date Applied</label>
            <InputDate class="form-control" @bind-Value="Application.DateApplied" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <InputSelect class="form-control" @bind-Value="Application.Status">
                <option value="Pending">Pending</option>
                <option value="Reviewed">Reviewed</option>
                <option value="Accepted">Accepted</option>
                <option value="Rejected">Rejected</option>
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary ms-2" href="/applications">Back</a>
    </EditForm>
}


@code {
    [Parameter] public int Id { get; set; }

    private JobBoardContext? _context;
    private bool _loading = true;
    private Application? Application;

    protected override async Task OnInitializedAsync()
    {
        _context = await DbFactory.CreateDbContextAsync();

        Application = await _context.Application
            .Include(a => a.JobListing)
            .FirstOrDefaultAsync(a => a.Id == Id);

        _loading = false;
    }

    private async Task UpdateApplication()
    {
        if (_context == null || Application == null) return;

        _context.Application.Update(Application);
        await _context.SaveChangesAsync();

        Nav.NavigateTo("/applications");
    }
}
