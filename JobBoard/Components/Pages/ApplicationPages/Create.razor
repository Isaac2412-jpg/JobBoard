@page "/applications/create/{JobListingId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using JobBoard.Components.Domain
@using JobBoard.Data
@implements IAsyncDisposable

@inject IDbContextFactory<JobBoardContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Create Application</PageTitle>

<h1>Create</h1>
<h2>Application</h2>
<hr />

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Status will be set to <b>Pending</b> automatically.</p>

    <button class="btn btn-primary" @onclick="AddApplication">Apply</button>

    <p class="mt-3">
        <a href="/joblistings">Back to List</a>
    </p>
}

@code {
    [Parameter] public int JobListingId { get; set; }

    private JobBoardContext? context;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        context = await DbFactory.CreateDbContextAsync();
        _loading = false;
    }

    private async Task AddApplication()
    {
        if (context == null) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        // must have a JobSeeker profile first
        var jobSeekerProfile = await context.JobSeeker.FirstOrDefaultAsync(j => j.IdentityUserId == userId);
        if (jobSeekerProfile == null)
        {
            NavigationManager.NavigateTo("/jobseekers/create");
            return;
        }

        // prevent duplicate apply (same Identity user applying same job)
        var alreadyApplied = await context.Application
            .AnyAsync(a => a.JobListingId == JobListingId && a.JobSeekerId == userId);

        if (alreadyApplied)
        {
            NavigationManager.NavigateTo("/applications");
            return;
        }

        var application = new Application
        {
            JobListingId = JobListingId,
            JobSeekerId = userId,          // IMPORTANT: store Identity GUID
            DateApplied = DateTime.Now,
            Status = "Pending"
        };

        context.Application.Add(application);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/applications");
    }

    public async ValueTask DisposeAsync()
    {
        if (context != null)
            await context.DisposeAsync();
    }
}
